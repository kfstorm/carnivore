#!/usr/bin/env bash

set -euo pipefail

wrapper_version="0.1.0"
default_image="ghcr.io/kfstorm/carnivore:latest"

if [[ ${1:-} == "--version" || ${1:-} == "-V" ]]; then
  printf 'carnivore %s\n' "${wrapper_version}"
  exit 0
fi

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  cat <<'EOF'
Usage: carnivore URL [OPTIONS]

Fetch readable web content with Carnivore's Dockerized browser pipeline.

Options:
  --format markdown|html|full_html  Extracted content format. Default: markdown.
  --output raw|json                 CLI output mode. Default: raw.
  --resource-mode omit|link|embed    Resource output mode for Markdown/HTML. Default: omit.
                                       omit: remove images/media; link: keep original links; embed: inline resources.
  --verbose                         Print progress logs to stderr. Default: quiet unless an error occurs.
  -V, --version                     Show the wrapper version without starting Docker.
  -h, --help                        Show this help message. Default: not shown.

Environment:
  CARNIVORE_CACHE=1                 Enable the cache volume. Disabled by default.
  CARNIVORE_CACHE_VOLUME=NAME       Docker cache volume. Default: carnivore-cache.
  CARNIVORE_IMAGE=IMAGE             Override the Docker image. Default: official Carnivore image.
  CARNIVORE_PULL=0|1                Control Docker image pulls. Default: pull at most once per day.
  CARNIVORE_STATE_DIR=DIR           State directory for pull timestamps. Default: XDG state directory.
  CARNIVORE_DOCKER_ARGS=ARGS        Extra resource docker run arguments. Network and
                                    security overrides are rejected.
  CARNIVORE_RESOURCE_MODE=MODE      Same as --resource-mode. Values: omit, link, embed.
  CARNIVORE_ZENROWS_API_KEY         Pass Zenrows API key. Default: unset.
  CARNIVORE_ZENROWS_PREMIUM_PROXIES Pass Zenrows premium proxy flag. Default: unset.
  CARNIVORE_ZENROWS_JS_RENDERING    Pass Zenrows JS rendering flag. Default: unset.
  CARNIVORE_OXYLABS_USER            Pass OxyLabs credentials. Default: unset.
  CARNIVORE_OXYLABS_JS_RENDERING    Pass OxyLabs JS rendering flag. Default: unset.
EOF
  exit 0
fi

is_ipv4_loopback() {
  local host=$1
  local -a octets

  if [[ ! ${host} =~ ^127\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    return 1
  fi

  IFS=. read -r -a octets <<< "${host}"
  for octet in "${octets[@]}"; do
    if ((10#${octet} > 255)); then
      return 1
    fi
  done
}

is_loopback_url() {
  local url=${1:-}
  local authority host

  case ${url} in
  http://* | https://*) ;;
  *) return 1 ;;
  esac

  authority=${url#*://}
  authority=${authority%%/*}
  authority=${authority%%\?*}
  authority=${authority%%\#*}
  authority=${authority##*@}

  if [[ ${authority} == \[* ]]; then
    host=${authority#\[}
    host=${host%%\]*}
  else
    host=${authority%%:*}
  fi
  host=$(printf '%s' "${host}" | tr '[:upper:]' '[:lower:]')

  [[ ${host} == localhost ]] || is_ipv6_loopback "${host}" || is_ipv4_loopback "${host}"
}

is_ipv6_loopback() {
  local host=$1
  local left right part last
  local explicit_count last_index index
  local -a parts

  is_zero_hextet() {
    [[ ${1} =~ ^0{1,4}$ ]]
  }

  is_one_hextet() {
    [[ ${1} =~ ^0{0,3}1$ ]]
  }

  if [[ ${host} == *::* ]]; then
    [[ ${host} != *::*::* ]] || return 1
    left=${host%%::*}
    right=${host#*::}
    [[ -n ${right} ]] || return 1
    explicit_count=0

    if [[ -n ${left} ]]; then
      IFS=: read -r -a parts <<< "${left}"
      explicit_count=${#parts[@]}
      for part in "${parts[@]}"; do
        is_zero_hextet "${part}" || return 1
      done
    fi

    IFS=: read -r -a parts <<< "${right}"
    ((explicit_count += ${#parts[@]}))
    ((explicit_count < 8)) || return 1
    last_index=$((${#parts[@]} - 1))
    last=${parts[${last_index}]}
    is_one_hextet "${last}" || return 1
    for ((index = 0; index < last_index; index++)); do
      is_zero_hextet "${parts[${index}]}" || return 1
    done
    return 0
  fi

  IFS=: read -r -a parts <<< "${host}"
  (( ${#parts[@]} == 8 )) || return 1
  last_index=$((${#parts[@]} - 1))
  last=${parts[${last_index}]}
  is_one_hextet "${last}" || return 1
  for ((index = 0; index < last_index; index++)); do
    is_zero_hextet "${parts[${index}]}" || return 1
  done
}

extra_docker_args=()
if [[ -n ${CARNIVORE_DOCKER_ARGS:-} ]]; then
  # shellcheck disable=SC2206
  extra_docker_args=(${CARNIVORE_DOCKER_ARGS})
fi

for extra_arg in "${extra_docker_args[@]}"; do
  case ${extra_arg} in
  --network | --network=* | --net | --net=*)
    echo "invalid_input: CARNIVORE_DOCKER_ARGS cannot override network mode" >&2
    exit 2
    ;;
  --privileged | --privileged=* | --user | --user=* | -u | -u=* | -u?* | --cap-add | --cap-add=* | \
    --cap-drop | --cap-drop=* | --security-opt | --security-opt=* | --read-only | \
    --read-only=* | --userns | --userns=*)
    echo "invalid_input: CARNIVORE_DOCKER_ARGS cannot override container security" >&2
    exit 2
    ;;
  esac
done

if ! command -v docker > /dev/null; then
  echo "Docker is required to run carnivore-fetch." >&2
  exit 1
fi

image=${CARNIVORE_IMAGE:-${default_image}}
cache_volume=${CARNIVORE_CACHE_VOLUME:-carnivore-cache}
state_dir=${CARNIVORE_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/carnivore-fetch}
image_state_name=${image//[^[:alnum:]._-]/_}
pull_stamp="${state_dir}/pull-${image_state_name}.stamp"

pull_image() {
  pull_output=$(mktemp)
  if docker pull "${image}" > "${pull_output}" 2>&1; then
    rm -f "${pull_output}"
    return 0
  else
    pull_status=$?
    cat "${pull_output}" >&2
    rm -f "${pull_output}"
    return "${pull_status}"
  fi
}

update_pull_stamp() {
  mkdir -p "${state_dir}"
  printf '%s\n' "${1:-$(date +%s)}" > "${pull_stamp}"
}

pull_mode=${CARNIVORE_PULL:-daily}
if [[ ${pull_mode} == "1" ]]; then
  pull_image
  update_pull_stamp
elif [[ ${pull_mode} != "0" ]]; then
  now=$(date +%s)
  last_pull=0

  if [[ -r ${pull_stamp} ]]; then
    read -r last_pull < "${pull_stamp}" || true
  fi

  if ! [[ ${last_pull} =~ ^[0-9]+$ ]]; then
    last_pull=0
  fi

  if (( now < last_pull || now - last_pull >= 86400 )); then
    pull_image
    update_pull_stamp "${now}"
  fi
fi

network_mode=bridge
if is_loopback_url "${1:-}"; then
  network_mode=host
fi

docker_args=(
  --rm
  --network
  "${network_mode}"
  --user
  1000:1000
  --read-only
  --cap-drop
  ALL
  --security-opt
  no-new-privileges
  --tmpfs
  "/tmp:rw,noexec,nosuid,nodev,size=64m"
  --shm-size
  64m
  --cpus
  2
  --memory
  1g
  --pids-limit
  256
  -e
  CARNIVORE_APPLICATION=fetch
  -e
  CARNIVORE_OUTPUT_FORMATS=markdown
  -e
  CARNIVORE_OUTPUT_DIR=/tmp/carnivore
)

if [[ ${CARNIVORE_CACHE:-} == "1" ]]; then
  docker_args+=(
    -v
    "${cache_volume}:/cache:rw"
    -e
    CARNIVORE_CACHE=1
    -e
    CARNIVORE_CACHE_DIR=/cache
  )
else
  docker_args+=(
    -e
    CARNIVORE_CACHE=0
  )
fi

for env_name in \
  CARNIVORE_ZENROWS_API_KEY \
  CARNIVORE_ZENROWS_PREMIUM_PROXIES \
  CARNIVORE_ZENROWS_JS_RENDERING \
  CARNIVORE_RESOURCE_MODE \
  CARNIVORE_OXYLABS_USER \
  CARNIVORE_OXYLABS_JS_RENDERING; do
  if [[ -n ${!env_name:-} ]]; then
    docker_args+=(-e "${env_name}")
  fi
done

if ((${#extra_docker_args[@]} > 0)); then
  docker_args+=("${extra_docker_args[@]}")
fi

if [[ ${network_mode} == host ]]; then
  run_output_dir=$(mktemp -d)
  if docker run "${docker_args[@]}" "${image}" "$@" \
    > "${run_output_dir}/stdout" 2> "${run_output_dir}/stderr"; then
    cat "${run_output_dir}/stdout"
    cat "${run_output_dir}/stderr" >&2
    rm -rf "${run_output_dir}"
    exit 0
  else
    run_status=$?
  fi

  run_error=$(< "${run_output_dir}/stderr")
  lower_run_error=$(printf '%s' "${run_error}" | tr '[:upper:]' '[:lower:]')
  if [[ ${lower_run_error} == *"host network"* ]] ||
    [[ ${lower_run_error} == *"network host"* ]] ||
    [[ ${lower_run_error} == *"host networking"* ]] ||
    [[ ${lower_run_error} == *"host"* && ${lower_run_error} == *"not supported"* ]] ||
    [[ ${lower_run_error} == *"host"* && ${lower_run_error} == *"disabled"* ]]; then
    rm -rf "${run_output_dir}"
    echo "network_error: Host networking is unavailable or disabled. Enable host networking in Docker Desktop, or use a Docker Engine with host networking support." >&2
    exit 1
  fi

  cat "${run_output_dir}/stdout"
  cat "${run_output_dir}/stderr" >&2
  rm -rf "${run_output_dir}"
  exit "${run_status}"
fi

exec docker run "${docker_args[@]}" "${image}" "$@"
